# Chaîne de connexion Postgres (Neon). Sur Vercel, elle est ajoutée automatiquement
# quand tu connectes une base Neon depuis l'onglet "Storage" du projet.
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Secret pour signer les cookies de session. Génère-le avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="change-moi"

# Envoi des e-mails de "mot de passe oublié" (Gmail, gratuit).
# SMTP_PASS est un "mot de passe d'application" Google (pas ton vrai mot de passe) :
#   https://myaccount.google.com/apppasswords  (la validation en 2 étapes doit être activée)
# Sans ces variables en local, le lien de réinitialisation s'affiche dans le terminal.
SMTP_USER="ton.adresse@gmail.com"
SMTP_PASS="abcd efgh ijkl mnop"
# Optionnel : SMTP_HOST (défaut smtp.gmail.com), SMTP_PORT (défaut 465), MAIL_FROM.

# Optionnel : URL publique utilisée dans les liens des e-mails.
# Sur Vercel, l'URL de production est détectée automatiquement.
# APP_URL="https://vola-delta.vercel.app"
